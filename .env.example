# ─── Gemini API Configuration ───

# Your Gemini API key (required, never commit the actual key)
GEMINI_API_KEY=

# Primary model to use (the first model tried for every call)
# If this model fails, the system automatically cascades through fallbacks:
#   1. gemini-3.6-flash (primary)
#   2. gemini-3.5-flash (fallback 1)
#   3. gemini-2.5-flash (fallback 2)
#   4. gemini-2.0-flash (fallback 3)
GEMINI_MODEL=gemini-3.6-flash

# ─── Server Configuration ───
PORT=3001
